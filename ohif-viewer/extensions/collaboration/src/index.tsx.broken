/**
 * index.tsx - Minimal Safe Collaboration Extension
 */

import CollaborationService from './services/CollaborationService';

const extension = {
  id: '@ohif/extension-collaboration',
  version: '0.1.0',
  
  // Register service
  preRegistration: ({ servicesManager }) => {
    try {
      servicesManager.registerService(CollaborationService.REGISTRATION);
      console.log('✅ Collaboration service registered');
    } catch (error) {
      console.error('❌ Failed to register collaboration service:', error);
    }
  },
  

  // Register panel with simple component
  getPanelModule: () => {
    console.log('📦 getPanelModule called');
  
    // Simple inline component
    const CollaborationPanelPlaceholder = () => {
      return `
        <div style="padding: 20px; background: #1a1a1a; color: white; height: 100%;">
          <h3 style="margin: 0 0 10px 0;">Collaboration Panel</h3>
          <p style="margin: 0;">Panel loaded successfully!</p>
          <p style="margin-top: 10px; color: #888;">
            The collaboration extension is working. 
            Panel UI will be implemented next.
          </p>
        </div>
      `.trim();
    };
  
    // Return an OBJECT, not an array!
    return {
      collaboration: {
        name: 'collaboration',
        iconName: 'icon-users',
        iconLabel: 'Collaboration',
        label: 'Collaboration',
        component: CollaborationPanelPlaceholder,
      },
    };
  },
    
    return [
      {
        name: 'collaboration',
        iconName: 'icon-users',
        iconLabel: 'Collaboration',
        label: 'Collaboration',
        component: CollaborationPanelPlaceholder,
      },
    ];
  },
  
  // Commands module - return empty for now
  getCommandsModule: () => {
    console.log('📦 getCommandsModule called');
    return {
      definitions: {},
      defaultContext: 'DEFAULT',
    };
  },
  
  // Utility module - return empty
  getUtilityModule: () => {
    console.log('📦 getUtilityModule called');
    return [];
  },
  
  // Toolbar module - return empty  
  getToolbarModule: () => {
    console.log('📦 getToolbarModule called');
    return [];
  },
};

console.log('🚀 Collaboration extension loaded');

export default extension;