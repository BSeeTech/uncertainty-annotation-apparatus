##
# EXAMPLE
#
# Copy to .env for the local Uncertainty Annotation Apparatus (UAA) stack.
# Read more about .env files when using create-react-app here:
# https://facebook.github.io/create-react-app/docs/adding-custom-environment-variables#adding-development-environment-variables-in-env
#

# PUBLIC_URL must stay "/" for the local dev server (the app is served at the
# root of http://localhost:3000).
PUBLIC_URL=/

# The viewer config that talks to the local Docker stack (nginx -> Orthanc on
# 8043, uncertainty service via the same proxy). Do NOT use config/netlify.js
# or config/demo.js — those point at public demo servers.
APP_CONFIG=config/default.js
USE_HASH_ROUTER=false
