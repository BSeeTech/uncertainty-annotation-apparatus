# Medical Imaging Platform - example local environment
# Copy to .env for local Docker development and adjust as needed.

NODE_ENV=development

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=annotations
POSTGRES_USER=medical_imaging
POSTGRES_PASSWORD=uaa-evaluation-only
DATABASE_URL=postgresql://medical_imaging:uaa-evaluation-only@postgres:5432/annotations
DATABASE_URL_HOST=postgresql://medical_imaging:uaa-evaluation-only@localhost:5432/annotations
DATABASE_CONNECT_RETRY_SECONDS=90
DATABASE_CONNECT_RETRY_INTERVAL_SECONDS=2

# Orthanc
ORTHANC_URL=http://orthanc:8042
ORTHANC_DICOMWEB_ROOT=http://orthanc:8042/dicom-web
ORTHANC_WADO_ROOT=http://orthanc:8042/wado
ORTHANC_URL_EXTERNAL=http://localhost:8042
ORTHANC_DICOMWEB_ROOT_EXTERNAL=http://localhost:8042/dicom-web
ORTHANC_WADO_ROOT_EXTERNAL=http://localhost:8042/wado
ORTHANC_USERNAME=admin
ORTHANC_PASSWORD=orthanc2024
ORTHANC_AUTH_ENABLED=false

# MONAI Label
MONAI_LABEL_URL=http://monai-label:8000
MONAI_LABEL_URL_EXTERNAL=http://localhost:8000
MONAI_LABEL_TIMEOUT_SECONDS=7200
MC_DROPOUT_SAMPLES=16
MONAI_CHECKPOINT_PATH=/workspace/app/model/pretrained_segmentation.pt
MONAI_CHECKPOINT_LOCK=/workspace/app/model/checkpoint.lock.json
CUDA_VISIBLE_DEVICES=-1
OMP_NUM_THREADS=16

# Uncertainty service
UNCERTAINTY_SERVICE_URL=http://localhost:8043/uncertainty
PUBLIC_UNCERTAINTY_SERVICE_URL=http://localhost:8043/uncertainty
ORTHANC_DICOMWEB_URL=http://orthanc:8042/dicom-web
DEFAULT_CASE_CONDITION=C2
UNCERTAINTY_OUTPUT_DIR=/var/lib/uncertainty-service/outputs
EVALUATION_CASES_PATH=/evaluation/cases.json

# Collaboration server
COLLABORATION_SERVER_URL=http://localhost:3001
COLLABORATION_SERVER_PORT=3001

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8042,http://localhost:8043,http://localhost:8044,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Security placeholders for local development only
JWT_SECRET=change-me-in-production-use-long-random-string
SESSION_SECRET=another-long-random-string-for-sessions

# Logging
LOG_LEVEL=info
